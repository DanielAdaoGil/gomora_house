<style>
:root{--ink:#fff;--dim:rgba(255,255,255,.62);--faint:rgba(255,255,255,.34);--accent:#ff2338;--accent2:#7d0a14;--ring:rgba(255,35,56,.34);--ring2:rgba(255,35,56,.10);--fd:'Playfair Display',Georgia,serif;--fb:'Inter',system-ui,sans-serif;--fx:'Bebas Neue',Impact,sans-serif}
*{box-sizing:border-box;margin:0;padding:0}
html{background:#050304;scrollbar-width:none;-ms-overflow-style:none}
html::-webkit-scrollbar{width:0;height:0}
html,body{height:100%}
body{background:#050304;color:var(--ink);font-family:var(--fb);overflow:hidden;scrollbar-width:none;-ms-overflow-style:none}
body::-webkit-scrollbar{width:0;height:0}
body.locked{overflow:hidden}
img{-webkit-user-drag:none;user-select:none}
a{color:inherit}
/* ---- animated red-to-black background ---- */
#bg{position:fixed;inset:-20%;z-index:0;pointer-events:none;filter:saturate(1.15);background:radial-gradient(42% 55% at 18% 22%,rgba(255,35,56,.34),transparent 70%),radial-gradient(48% 60% at 84% 30%,rgba(125,10,20,.55),transparent 70%),radial-gradient(60% 70% at 55% 88%,rgba(255,35,56,.20),transparent 70%),radial-gradient(35% 45% at 78% 78%,rgba(255,120,120,.12),transparent 70%),linear-gradient(160deg,#160306 0%,#050304 45%,#0d0204 70%,#050304 100%);animation:bgdrift 26s ease-in-out infinite alternate}
@keyframes bgdrift{0%{transform:translate3d(-2.5%,-1.5%,0) scale(1)}50%{transform:translate3d(2%,2%,0) scale(1.06)}100%{transform:translate3d(-1%,2.5%,0) scale(1.03)}}
#bg .orb{position:absolute;border-radius:50%;filter:blur(70px);mix-blend-mode:screen}
#bg .o1{width:44vmax;height:44vmax;left:-10vmax;top:-12vmax;background:radial-gradient(circle,rgba(255,35,56,.5),transparent 65%);animation:orb1 21s ease-in-out infinite alternate}
#bg .o2{width:52vmax;height:52vmax;right:-14vmax;top:6vmax;background:radial-gradient(circle,rgba(125,10,20,.75),transparent 65%);animation:orb2 30s ease-in-out infinite alternate}
#bg .o3{width:40vmax;height:40vmax;left:22vw;bottom:-16vmax;background:radial-gradient(circle,rgba(255,35,56,.30),transparent 65%);animation:orb1 26s ease-in-out infinite alternate-reverse}
@keyframes orb1{from{transform:translate(0,0)}to{transform:translate(9vmax,6vmax)}}
@keyframes orb2{from{transform:translate(0,0)}to{transform:translate(-8vmax,9vmax)}}
@media(prefers-reduced-motion:reduce){#bg,#bg .orb,#cue .bar i{animation:none}}
/* ---- sphere ---- */
#stage{position:relative;height:100vh;height:100lvh;min-height:560px;z-index:1;transition:filter .45s ease}
#vig{position:fixed;inset:0;z-index:2;pointer-events:none;background:radial-gradient(120% 90% at 50% 45%,transparent 55%,rgba(0,0,0,.55))}
.card{position:absolute;left:0;top:0;will-change:transform,filter;transform-style:preserve-3d;cursor:pointer}
.card figure{position:relative;margin:0;width:var(--cw);aspect-ratio:2/3;background:#0c0708;overflow:hidden;border:1px solid rgba(255,255,255,.08);box-shadow:0 18px 50px rgba(0,0,0,.55)}
.card img.in{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.card .shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.26),transparent 30%,transparent 60%,rgba(0,0,0,.68));pointer-events:none}
.card figcaption{position:absolute;left:0;right:0;bottom:0;display:flex;align-items:center;gap:7px;padding:8px 9px;background:linear-gradient(0deg,rgba(5,0,1,.88),transparent)}
.epnum{font-family:var(--fx);font-size:clamp(17px,2.2vw,26px);line-height:1;letter-spacing:.06em;color:#fff;background:linear-gradient(180deg,var(--accent),#a60f1d);padding:3px 8px 2px;border-radius:4px;box-shadow:0 4px 14px rgba(255,35,56,.45)}
.ept{font-size:9px;letter-spacing:.28em;color:rgba(255,255,255,.85)}
.ring,.hide{position:absolute;top:0;left:0;pointer-events:none}
.ring{z-index:2}.hide{z-index:3;overflow:hidden}
.ring span{position:absolute;top:0;background:var(--ring);border-radius:99px}
.hide span{position:absolute;top:0;background:var(--ring)}
.hide img{position:absolute;top:0;object-fit:cover}
.ringgal{position:absolute;top:0;left:0;color:rgba(255,120,130,.6);font-size:10px;letter-spacing:.22em;pointer-events:none;z-index:2;white-space:nowrap}
.tit{position:absolute;top:0;color:#ffd9dc;font-family:var(--fx);font-size:15px;letter-spacing:.14em;text-shadow:0 2px 10px rgba(0,0,0,.8)}
