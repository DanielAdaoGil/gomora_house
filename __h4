/* ---- menu ---- */
#menu{position:fixed;inset:0;z-index:13;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;background:radial-gradient(60% 60% at 50% 55%,rgba(60,4,9,.92),rgba(4,1,1,.97));opacity:0;pointer-events:none;transition:opacity .45s}
body.menu #menu{opacity:1;pointer-events:auto}
#menu a{font-family:var(--fd);font-size:clamp(34px,6vw,64px);color:rgba(255,255,255,.55);text-decoration:none;transition:color .3s,letter-spacing .3s}
#menu a:hover{color:#fff;letter-spacing:.04em}
#menu a.se{color:var(--accent)}
.menub.x i{background:transparent;box-shadow:none;position:relative}
.menub.x i:before,.menub.x i:after{content:"";position:absolute;left:0;top:0;width:26px;height:1px;background:var(--accent)}
.menub.x i:before{transform:rotate(45deg)}.menub.x i:after{transform:rotate(-45deg)}
/* ---- intro/splash ---- */
#intro{position:fixed;inset:0;z-index:30;background:#000;display:flex;align-items:center;justify-content:center}
#intro video{width:100%;height:100%;object-fit:cover}
#intro.out{opacity:0;pointer-events:none;transition:opacity .9s}
#skip{position:absolute;right:26px;bottom:26px;z-index:31;background:rgba(0,0,0,.55);border:1px solid var(--ring);color:#fff;font-size:11px;letter-spacing:.3em;padding:12px 22px;cursor:pointer}
#skip:hover{background:rgba(255,35,56,.25)}
#boot{position:fixed;inset:0;z-index:40;display:flex;flex-direction:column;align-items:center;justify-content:center;background:radial-gradient(60% 55% at 50% 45%,#1d0407,#050304 75%)}
#boot h1{font-family:var(--fd);letter-spacing:.28em;font-size:clamp(22px,4vw,40px)}
#boot h1 b{color:var(--accent);font-weight:700}
#boot .t{width:min(300px,70vw);height:1px;background:rgba(255,255,255,.14);margin:26px 0 12px}
#boot .t i{display:block;height:100%;width:0;background:var(--accent)}
#boot small{font-size:10px;letter-spacing:.4em;color:var(--dim)}
/* ---- responsive ---- */
@media(max-width:640px){
.word{left:18px;top:16px;font-size:12px}
.menub{right:18px;top:16px}
.col{display:none}
.cue{bottom:120px}
#gridb{right:50%;transform:translateX(50%);bottom:34px;white-space:nowrap}
#cards{grid-template-columns:repeat(2,1fr);gap:14px}
#gridv .wrap{padding:90px 16px 110px}
#lbody{padding:20px 20px 24px}
#lbody h3{font-size:28px}
.ept{display:none}
}
@media(min-width:641px) and (max-width:1024px){#cards{grid-template-columns:repeat(3,1fr)}}
</style>
</head>
