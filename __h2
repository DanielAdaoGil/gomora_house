/* ---- hero (post-entry) ---- */
#hero{position:fixed;inset:0;z-index:5;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:0 20px;pointer-events:none;opacity:0;transition:opacity .7s}
body.hero #hero{opacity:1}
body.heroGone #hero{opacity:0}
#hero .kick{font-size:11px;letter-spacing:.5em;color:var(--accent);margin-bottom:18px;text-shadow:0 0 24px rgba(255,35,56,.6)}
#hero h2{font-family:var(--fd);font-weight:700;font-size:clamp(38px,7.5vw,96px);line-height:1.06;text-shadow:0 8px 44px rgba(0,0,0,.7)}
#hero h2 em{font-style:italic;color:#ff8f99}
#hero p{margin-top:20px;font-size:12px;letter-spacing:.34em;color:var(--dim)}
#hero .go{margin-top:30px;font-size:10px;letter-spacing:.42em;color:var(--faint)}
#hero .go b{display:block;width:1px;height:44px;margin:12px auto 0;background:linear-gradient(var(--accent),transparent)}
/* ---- grid ---- */
#gridv{position:fixed;inset:0;z-index:9;overflow-y:auto;overscroll-behavior:contain;background:rgba(6,1,2,.9);backdrop-filter:blur(14px);scrollbar-width:none;opacity:0;pointer-events:none;transition:opacity .45s}
#gridv::-webkit-scrollbar{width:0;height:0}
body.grid #gridv{opacity:1;pointer-events:auto}
#gridv .wrap{max-width:1180px;margin:0 auto;padding:110px 26px 120px}
#gridv h2{font-family:var(--fd);font-size:clamp(28px,4.5vw,52px);text-align:center;margin-bottom:8px}
#gridv .sub{text-align:center;font-size:11px;letter-spacing:.34em;color:var(--dim);margin-bottom:36px}
#cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:22px}
#cards figure{position:relative;margin:0;aspect-ratio:2/3;overflow:hidden;border:1px solid rgba(255,255,255,.1);cursor:pointer;background:#0c0708}
#cards img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .5s}
#cards figure:hover img{transform:scale(1.07)}
#cards .sh{position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,rgba(5,0,1,.9))}
#cards figcaption{position:absolute;left:0;right:0;bottom:0;display:flex;align-items:center;gap:8px;padding:10px}
